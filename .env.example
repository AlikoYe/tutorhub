# Copy to .env and adjust. Used by `make dev` (backend + Vite) and by
# docker compose (api service via env_file, postgres/caddy via --env-file).

# dev | staging | prod. Only "dev" enables "Authorization: dev <telegram_id>".
APP_ENV=dev
HTTP_ADDR=:8080
# debug | info | warn | error
LOG_LEVEL=debug

# Used when running the API on the host (make dev). Inside docker compose the
# api/migrate services build their own URL pointing at the postgres service.
DATABASE_URL=postgres://tutorhub:tutorhub@localhost:5432/tutorhub?sslmode=disable

POSTGRES_USER=tutorhub
POSTGRES_PASSWORD=tutorhub
POSTGRES_DB=tutorhub
POSTGRES_PORT=5432

# From @BotFather. Required unless APP_ENV=dev (the bot is disabled when empty).
BOT_TOKEN=
# Bot username without @, for personal links t.me/<bot>?start=t_<id>.
BOT_USERNAME=
# Public HTTPS URL of the Mini App (e.g. your tunnel URL); used by bot buttons.
WEBAPP_URL=

# Public website base URL (canonical links, sitemap). Defaults to WEBAPP_URL.
SITE_URL=

# Comma-separated Telegram ids that are made admins at startup.
ADMIN_TELEGRAM_IDS=

# Time zone for lessons, schedules and statistics.
TIMEZONE=Asia/Almaty
# Where teacher photos and documents are stored (a docker volume in production).
UPLOAD_DIR=./data/uploads

# Minutes a lesson request waits for the teacher before it expires (never past the lesson start).
# Paid plans in KZT per month and how teachers pay (manual Kaspi transfer in the MVP).
PRICE_BASIC_KZT=2990
PRICE_FEATURED_KZT=7990
PAYMENT_INSTRUCTIONS=
# Length of the trial plan started when an admin approves a profile.
TRIAL_DAYS=30

HOLD_MINUTES=360

# How often the worker runs, and how early lesson reminders go out (Go durations).
REMINDER_INTERVAL=1m
REMINDER_BEFORE=2h
SHUTDOWN_TIMEOUT=10s

# Caddy site address: ":80" locally, or your domain for automatic HTTPS.
SITE_ADDRESS=:80

# Frontend: telegram id sent as "Authorization: dev <id>" outside Telegram.
VITE_DEV_TELEGRAM_ID=1
