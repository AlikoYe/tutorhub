# Edge proxy: TLS for every public host on this VM, then plain HTTP to the project's web
# container. Site files are generated by install.sh into /opt/edge/sites (one per host).
{
	# Certificates and ACME account live in the edge_data volume.
	servers {
		protocols h1 h2 h3
	}
}

import /etc/caddy/sites/*.caddy
