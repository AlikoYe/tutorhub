# Production config. Copy to /opt/tutorhub/.env and fill in every CHANGE_ME (docs/deploy.md).
APP_ENV=prod
HTTP_ADDR=:8080
LOG_LEVEL=info

POSTGRES_USER=tutorhub
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=tutorhub

BOT_TOKEN=CHANGE_ME
BOT_USERNAME=
WEBAPP_URL=https://tutorhub.example.kz
ADMIN_TELEGRAM_IDS=

TIMEZONE=Asia/Almaty
UPLOAD_DIR=/data/uploads
HOLD_MINUTES=360
REMINDER_INTERVAL=1m
REMINDER_BEFORE=2h
SHUTDOWN_TIMEOUT=10s

SITE_ADDRESS=tutorhub.example.kz
