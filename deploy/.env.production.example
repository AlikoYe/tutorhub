# TutorHub production config. Copy to /opt/tutorhub/.env and replace every CHANGE_ME
# (docs/deploy.md, step 3). Never commit the real file.

# ---- App -------------------------------------------------------------------
# Must be prod on the server: only signed Telegram initData logs in.
APP_ENV=prod
HTTP_ADDR=:8080
# debug | info | warn | error
LOG_LEVEL=info

# ---- Database (the tutorhub Postgres container; never published) -------------
POSTGRES_USER=tutorhub
# Long random string, e.g. the output of: openssl rand -hex 24
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=tutorhub

# ---- Telegram ---------------------------------------------------------------
# Token of the PRODUCTION bot from @BotFather (a different bot than your laptop's dev bot).
BOT_TOKEN=CHANGE_ME
# The production bot's username without @ (for personal links t.me/<bot>?start=t_<id>).
BOT_USERNAME=CHANGE_ME
# Public HTTPS URL of the Mini App: https://<TUTORHUB_HOST>. Sets the bot's menu button.
WEBAPP_URL=https://tutorhub.example.kz
# Public website base URL for canonical links and the sitemap (usually the same as WEBAPP_URL).
SITE_URL=https://tutorhub.example.kz
# Comma-separated Telegram ids promoted to admin at startup.
ADMIN_TELEGRAM_IDS=888659722

# ---- Business settings -------------------------------------------------------
TIMEZONE=Asia/Almaty
# Inside the api container; backed by the tutorhub_uploads volume.
UPLOAD_DIR=/data/uploads
# Paid plans in KZT per month (placeholders until validated with teachers).
PRICE_BASIC_KZT=2990
PRICE_FEATURED_KZT=7990
# Shown to teachers on the subscription page. Empty = a default Russian text.
PAYMENT_INSTRUCTIONS=
# Length of the trial plan started when an admin approves a profile.
TRIAL_DAYS=30
# Minutes a lesson request waits for the teacher (never past the lesson start).
HOLD_MINUTES=360

# ---- Worker -----------------------------------------------------------------
REMINDER_INTERVAL=1m
REMINDER_BEFORE=2h
SHUTDOWN_TIMEOUT=10s

# ---- Web ---------------------------------------------------------------------
# Your TutorHub domain (no https://). Used only by deploy.sh for the public health check;
# the web container always serves plain :80 behind the shared edge proxy.
SITE_ADDRESS=tutorhub.example.kz
